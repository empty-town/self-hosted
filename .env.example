# Copy this file to .env, then set the values below.
#   cp .env.example .env && chmod 600 .env
# bootstrap.sh fills every empty "Generated" value for you.

# --- Required. You must set these two. ---

# Your domain. The stacks use it to build service names, e.g. jellyfin.<DOMAIN>.
DOMAIN=example.com

# Your timezone, in "Region/City" form. This makes log timestamps correct.
# Find yours at https://en.wikipedia.org/wiki/List_of_tz_database_time_zones
TZ=Etc/UTC

# --- Generated by bootstrap.sh. Leave these empty. ---
# bootstrap.sh writes a random secret into each empty value.
CROWDSEC_API_KEY=
IMMICH_DB_PASSWORD=
NC_DB_PASSWORD=
NC_DB_ROOT_PASSWORD=

# --- Data paths. Change these if you want the data somewhere else. ---
# These folders hold your photos and files. Create them before you start
# the stacks (Step 4 shows how).
IMMICH_UPLOAD_DIR=/mnt/photos
NC_DATA_DIR=/mnt/nextcloud-data

# --- Optional: dynamic DNS. Set this ONLY if you turn on the ddns service. ---
# You need it only if your public IP changes (a dynamic residential IP).
# Create a Cloudflare API token scoped to "Zone.DNS Edit" on your zone,
# then paste it here. See the ddns service in docker-compose.yml to turn it on.
CF_API_TOKEN=
